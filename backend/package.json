{
  "name": "edbase-backend",
  "version": "2.0.0",
  "description": "EdBase Student & Academic Management Platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test:unit": "node --import tsx --test src/__tests__/*.unit.test.ts",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:backup": "./scripts/db-backup.sh",
    "db:restore": "./scripts/db-restore.sh"
  },
  "keywords": [
    "edbase",
    "express",
    "prisma",
    "postgresql",
    "multi-tenant",
    "socketio",
    "gemini-ai",
    "typescript"
  ],
  "author": "dotDRN",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotDRN/edbase.git",
    "directory": "backend"
  },
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.6.0",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
