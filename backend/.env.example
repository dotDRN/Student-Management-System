# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Runtime connection string. On Supabase, use the Transaction Pooler URI (:6543)
# with ?pgbouncer=true&sslmode=require (or Session Pooler if preferred).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct/Session connection used by Prisma CLI migrations (`prisma migrate deploy`).
# On Supabase, use the Direct or Session Pooler URI (:5432). Defaults to DATABASE_URL if omitted.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional pool tuning & explicit SSL override ("true" | "false")
# DB_POOL_MAX=10
# DATABASE_SSL=true

# ─── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate strong secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ─── Server & CORS ─────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Allowed frontend origin(s) for Express & Socket.IO CORS (comma-separated for multiple)
# In production on Render, set this to your live URL (e.g. https://edbase.onrender.com)
CLIENT_URL=http://localhost:5173
# FRONTEND_URL=https://edbase.onrender.com
# CORS_ORIGINS=https://edbase.onrender.com

# Refresh cookie SameSite mode ("lax" for same-origin/single Render service, "none" for cross-origin SPA)
# COOKIE_SAME_SITE=lax
# COOKIE_CROSS_SITE=false

# ─── Cloudinary (Chat Attachments & Student Document Vault) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or a single Cloudinary URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ─── KoboToolbox Integration (Optional) ────────────────────────────────────────
KOBO_API_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=

# ─── Universal AI Orchestrator (Google Gemini — Optional) ──────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
