{
  "name": "edbase",
  "version": "2.0.0",
  "private": true,
  "description": "Multi-tenant, offline-first academic operations and student workspace platform with real-time collaboration and Gemini AI intelligence.",
  "keywords": [
    "edtech",
    "student-management-system",
    "multi-tenant",
    "offline-first",
    "pwa",
    "dexie",
    "react",
    "typescript",
    "express",
    "prisma",
    "postgresql",
    "supabase",
    "socketio",
    "webrtc",
    "gemini-ai"
  ],
  "author": "dotDRN",
  "license": "MIT",
  "homepage": "https://github.com/dotDRN/edbase#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotDRN/edbase.git"
  },
  "bugs": {
    "url": "https://github.com/dotDRN/edbase/issues"
  },
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install && npm install --include=dev --prefix backend && npm install --include=dev --prefix frontend --legacy-peer-deps",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build": "npm run install:all && npm run build:backend && npm run build:frontend",
    "lint": "npm run lint --prefix frontend",
    "test:backend": "npm run test:unit --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "db:deploy": "npm run db:setup --prefix backend",
    "start": "node backend/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
